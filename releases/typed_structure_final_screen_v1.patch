+        selected = keys[idx]
+        reverse = arr[idx,1]*len(context.types)+arr[idx,0]
+        mask = torch.isin(keys, torch.cat([selected,reverse]))
+    return GraphInputs(arr[:,:2].T, states, fam, mask, idx, qf, attrs)
