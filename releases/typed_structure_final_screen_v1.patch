+        left=counters[u].copy();right=counters[v].copy()
+        left[(int(types[v]),r)]-=1;right[(int(types[u]),r)]-=1
+        for (ta,ra),ca in left.items():
+            if not ca:continue
+            for (tb,rb),cb in right.items():
+                if cb:out[2][canon((ta,ra,int(types[u]),r,int(types[v]),rb,tb))]+=ca*cb
+                ops+=1
