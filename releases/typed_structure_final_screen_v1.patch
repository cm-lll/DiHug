+        common=adj[u].keys() & adj[v].keys()
+        for w in common:
+            out[2][canon((int(types[w]),adj[u][w],int(types[u]),r,int(types[v]),adj[v][w],int(types[w]))) ]-=1
+            if u<v<w:triangles[tuple(sorted((int(types[u]),int(types[v]),int(types[w]))))]+=1
+        ops+=len(common)
