+
+def nnls_encode(features,basis):
+    f=np.asarray(features,dtype=np.float64);h=np.asarray(basis,dtype=np.float64)
+    if f.ndim!=2 or h.ndim!=2 or f.shape[1]!=h.shape[1] or h.shape[0]<1:raise ValueError('NNLS dimensions')
