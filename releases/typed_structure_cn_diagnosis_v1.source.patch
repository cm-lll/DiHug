+        self.branch=DegreeBranch(case['n_families'],case['n_types'],cfg['model']['width'])
+        self.arm=arm;self.feature_calls=0;self.feature_seconds=0.;self.encoding_seconds=0.;self.transfer_seconds=0.
+        if arm not in ('A','D','E'):
+            # CN is last in the original feature layout: remove every CN input
+            # and its learned readout columns, not merely mask a CN score.
+            start=self.joint_slices['CN'].start
+            first=self.joint_head[0];new=nn.Linear(start,first.out_features)
+            with torch.no_grad():new.weight.copy_(first.weight[:,:start]);new.bias.copy_(first.bias)
+            self.joint_head[0]=new;self.cn_feature_width=0;self.joint_slices['CN']=slice(start,start)
+        if arm in ('B','C','D','E'):
+            self.refex_projection=nn.Linear(feature_width(case['n_families']),cfg['model']['width'],bias=False)
+            nn.init.zeros_(self.refex_projection.weight)
+        if arm in ('C','E'):
+            if basis is None:raise ValueError('frozen basis required')
+            if isinstance(basis,dict):matrix=np.asarray(basis['basis'],dtype=np.float64);offsets=np.asarray(basis['offsets'],dtype=np.int64)
+            else:
+                # Historical small engineering fixtures only; no formal loader uses this.
+                value=np.asarray(basis,dtype=np.float64)
+                if value.ndim!=3 or value.shape[0]!=case['n_types']:raise ValueError('typed basis required')
+                offsets=np.arange(case['n_types']+1,dtype=np.int64)*value.shape[1];matrix=value.reshape(-1,value.shape[-1])
+            if matrix.ndim!=2 or matrix.shape[1]!=feature_width(case['n_families']) or offsets.shape!=(case['n_types']+1,) or offsets[0]!=0 or offsets[-1]!=len(matrix) or (np.diff(offsets)<=0).any():raise ValueError('dynamic typed basis shape')
+            if not np.isfinite(matrix).all() or (matrix<0).any() or not np.allclose(np.linalg.norm(matrix,axis=1),1.,atol=1e-12,rtol=1e-12):raise ValueError('finite nonnegative unit-L2 basis required')
