+    architecture_version='typed_structure_192_oabc_v1'
+    def __init__(self,case,cfg,arm,basis=None):
+        if arm not in ('O','A','B','C','D','E'):raise ValueError('arm')
+        args=dict(cfg['model']);args['cn_hidden']=32 if arm in ('A','D','E') else 0
