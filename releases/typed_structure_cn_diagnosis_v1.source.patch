+
+    def _apply(self,fn):
+        result=super()._apply(fn)
+        if hasattr(self,'role_basis'):
+            self._basis_tensor_identity=self._role_identity()
+        return result
+
+def copy_common(source,target):
+    """Actually copy tensors; differing CN readout columns explicitly mapped."""
