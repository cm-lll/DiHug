+            ctx.node_residual=ctx.node_residual+self.refex_projection(ctx.structural_features)
+            if self.arm in ('C','E'):ctx.node_residual=ctx.node_residual+self.role_projection(ctx.structural_roles)
+        return super().joint_predict(ctx,graph,time,mask_cn,return_features)
+
+    def load_state_dict(self,state_dict,strict=True):
+        result=super().load_state_dict(state_dict,strict=strict)
+        if self.arm in ('C','E'):
+            self._basis_cpu=self.role_basis.detach().cpu().numpy().copy();self._basis_cpu.flags.writeable=False
+            self._offsets_cpu=self.role_offsets.detach().cpu().numpy().copy();self._offsets_cpu.flags.writeable=False
+            self._basis_hash=digest(self._basis_cpu,self._offsets_cpu)
+            self._basis_tensor_identity=self._role_identity()
