+        p=data['p0'];q=data['q'];tick_eval=time.monotonic()
+        before=evaluate(q,oldguide,row['t']-1,bundle.spec,check,cache)
+        old_record=next(x for x in bundle.old['records'] if (x['arm'],x['t'])==(row['arm'],row['t']))
