+    def distribution(x):
+        return dict(nodes=len(x), histogram=np.bincount(x).tolist(), mean=float(x.mean()) if len(x) else None,
+                    median=float(np.median(x)) if len(x) else None, max=int(x.max()) if len(x) else None)
