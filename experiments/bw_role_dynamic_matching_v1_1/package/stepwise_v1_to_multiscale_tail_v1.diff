+        num[i]=(g.statistic(k.reverse(a,state,l.families,t-1,t),t-1)[0]-g.statistic(k.reverse(b,state,l.families,t-1,t),t-1)[0])/(2*eps)
+    assert np.allclose(num,grad,atol=2e-8,rtol=2e-5)
