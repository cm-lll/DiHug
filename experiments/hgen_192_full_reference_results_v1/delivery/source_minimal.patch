+def delete_from_tail(array, target):
+    updated_array = []
+    for i in array:
+        temp = i.copy()
+        while temp[-1] == target:
+            temp = temp[:-1]
+        updated_array.append(temp)
+    
+    return updated_array
+
+
+def pad_along_axis(array, target_length, axis):
+    pad_size = target_length - array.shape[axis]
+    if pad_size <= 0:
+        return array
+    
+    padding = np.zeros([pad_size, array.shape[1]])
+    for i in range(len(padding)):
+        padding[i][-1] = 1
+        
+    return np.concatenate([array, padding], axis=axis)
+
+
+def load_HIN(directory="PubMed"):
+    """Load a SparseGraph from a file.
+
+    Parameters
+    ----------
+    file_name : str
+        Name of the file to load.
+
+    Returns
+    -------
+    sparse_graph : SparseGraph
+        Graph in sparse matrix format.
+
+    """
+    try:
+        new_node_dict = pickle.load(open(directory+"/new_node_dict.p","rb"))
+        adj_matrix = pickle.load(open(directory+"/adj_matrix.p","rb"))
+    except FileNotFoundError as e:
+        link_info = [i.strip().split()[:2] for i in open(directory+"/link.dat").readlines()]
+        node_info = [i.strip().split() for i in open(directory+"/node.dat").readlines()]
+        nodes = dict([(int(i[0]), int(i[2])) for i in node_info])
+        edges = [[int(i[0]), int(i[1])] for i in link_info]
+        #edge_types = [int(i[2]) for i in link_info]
+        # Getting subgraph from the original one
+        #subgraph = random.sample(list(nodes.keys()), k=7000)
+        subgraph = list(nodes.keys())[:10000]
+        edge_list = [i for i in edges if i[0] in subgraph and i[1] in subgraph]
+        #edge_type_list = [edge_types[i] for i, x in enumerate(edges) if x[0] in subgraph and x[1] in subgraph]
+        new_node_dict = dict(zip(subgraph, [nodes[i] for i in subgraph]))
+        adj_matrix = read_data_as_sp_matrix(edge_list)
+        
+        # Store pro-processed information
+        pickle.dump(new_node_dict, open(directory+"/new_node_dict.p", "wb"))
+        pickle.dump(adj_matrix, open(directory+"/adj_matrix.p", "wb"))
+        
+        #pickle.dump(edge_type_list, open(directory+"/edge_type_list.p", "wb"))
+    return new_node_dict, adj_matrix
+    
+
+def read_data_as_sp_matrix(edge_list):
+    "Read data file and return sparse matrix in coordinate format."
+    data = pd.DataFrame(edge_list)  
+    rows = data[0]  # Not a copy, just a reference.
+    cols = data[1]
+    ones = np.ones(len(rows), np.uint32)
+    n = max(max(rows), max(cols)) + 1
+    matrix = sp.csr_matrix((ones, (rows, cols)), shape=(n, n))
+    return matrix
+
+
+def group_dict(my_dict):
+    "Grouping dictionary keys by value"
+    res = defaultdict(list)
+    for key, val in sorted(my_dict.items()):
+        res[val].append(key)
+    
+    return dict(res)
+    
