+@pytest.mark.parametrize('p,f,t,n', [([.5,.5],[0,0],[1],[1]),([float('nan')],[0],[1],[1]),([1.2],[0],[1],[1]),([.5],[1],[1],[1]),([.5],[0],[2],[1])])
