+            g[~movable]=0.;norm=float(np.max(np.abs(g),initial=0))
+            record.update(raw_logit_gradient_max=norm,raw_logit_gradient_l2=float(np.linalg.norm(g)),gradient_floor=self.settings['gradient_floor'])
