+                     unique_pair_numerator=len(closed),unique_pair_denominator=len(pairs),
+                     unique_pair_ratio=len(closed)/len(pairs) if pairs else None)
+    triangle_total=sum(tr.values());cluster=[]
+    for u,a in enumerate(adj):
