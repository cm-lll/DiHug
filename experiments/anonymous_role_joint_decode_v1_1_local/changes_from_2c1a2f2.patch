 def sha(path):
     return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def audit_fixed_graph(case,a):
+    """Check BOTH representations first, then independently validate that graph."""
+    bits=np.asarray(a['fixed_assignment_bits']);slots=a['slots'];families=a['families'];types=a['types']
+    code=case['fixed_assignment_graph_code'];s=slots.shape[1];r=len(case['target']['family_pairs'])
+    if not isinstance(code,int) or code<0 or code>=2**s:raise AssertionError('fixed graph code range')
+    decoded=np.array([(code>>e)&1 for e in range(s)],dtype=np.uint8)
+    if bits.shape!=(s,) or not np.isin(bits,[0,1]).all() or not np.array_equal(bits,decoded):
+        raise AssertionError('fixed graph representations disagree')
+    degree=np.zeros((len(types),r),dtype=np.int64);seen=set()
+    for present,(u,v),family in zip(bits,slots.T,families):
+        if not present:continue
+        if not 0<=u<v<len(types) or (int(u),int(v)) in seen:raise AssertionError('fixed graph schema/simple')
+        seen.add((int(u),int(v)))
+        if sorted([int(types[u]),int(types[v])])!=case['target']['family_pairs'][family]:raise AssertionError('fixed graph family')
+        degree[u,family]+=1;degree[v,family]+=1
