diff --git a/experiments/pubmed_o_ema_runtime_v1/assessment.py b/experiments/pubmed_o_ema_runtime_v1/assessment.py
new file mode 100644
index 0000000..9502b80
--- /dev/null
+++ b/experiments/pubmed_o_ema_runtime_v1/assessment.py
@@ -0,0 +1,54 @@
+"""Frozen per-seed interpretation rules, not a new graph evaluator.
+
+Caller adapts the existing evaluator to edges, W1_incident4, LCC, family_edges.
+All original metrics remain in the returned records; no success-only average.
+"""
+import math
+SEEDS=(2026102812,2026102833)
+SAMPLES=(2026102821,2026102822)
+REFERENCE_FAMILY_EDGES=(39,137,159,17,83,267,27,161,33,3)
+def assess(records):
+    lookup={}
+    for r in records:
+        key=(r['train_seed'],r['readout'],r['sample_seed'])
+        if key in lookup:raise ValueError('duplicate identity')
+        if key[0] not in SEEDS or key[1] not in ('raw','ema') or key[2] not in SAMPLES:raise ValueError('unexpected identity')
+        lookup[key]=r
+    result={'per_seed':[],'original_records':records,'scope':'exploratory two training seeds; no statistical guarantee'}
+    for seed in SEEDS:
+        cell={'train_seed':seed,'status':'complete','raw':None,'ema':None,'redlines':None}
+        for readout in ('raw','ema'):
+            rs=[lookup.get((seed,readout,s)) for s in SAMPLES]
+            if any(r is None or r.get('status')!='complete' for r in rs):
+                cell['status']='incomplete';continue
+            keys=['edges','W1_incident4','LCC']
+            if any(any(r.get(k) is None or not math.isfinite(float(r[k])) for k in keys) or r.get('family_edges') is None for r in rs):
+                cell['status']='incomplete';continue
+            for r in rs:
+                if len(r['family_edges'])!=10 or sum(r['family_edges'])!=r['edges']:raise ValueError('relation counts do not sum to total')
+            cell[readout]=dict(edge_absolute_error=sum(abs(r['edges']-926) for r in rs)/2,
+                              signed_edge_bias=sum(r['edges']-926 for r in rs)/2,
+                              W1_incident4=sum(r['W1_incident4'] for r in rs)/2,
+                              LCC=sum(r['LCC'] for r in rs)/2,
+                              family_absolute_errors=[sum(abs(r['family_edges'][i]-REFERENCE_FAMILY_EDGES[i]) for r in rs)/2 for i in range(10)])
+        if cell['status']=='complete':
+            raw,ema=cell['raw'],cell['ema'];w=raw['W1_incident4']
+            cell['edge_error_difference']=ema['edge_absolute_error']-raw['edge_absolute_error']
+            cell['family_error_differences']=[e-r for e,r in zip(ema['family_absolute_errors'],raw['family_absolute_errors'])]
+            cell['redlines']=dict(W1_exceeds_10_percent=ema['W1_incident4']>1.1*w,
+                                  LCC_drop_exceeds_19_2=raw['LCC']-ema['LCC']>19.2)
+            cell['redline_note']='human-chosen non-adoption warnings; not proven safety or sufficient structural acceptance'
+        result['per_seed'].append(cell)
+    if any(c['status']!='complete' for c in result['per_seed']):
+        result.update(status='incomplete',accuracy_conclusion=None,pooled_error_difference=None,recommend_adoption=False)
+        return result
+    diffs=[c['edge_error_difference'] for c in result['per_seed']]
+    if all(d<0 for d in diffs):conclusion='consistent_accuracy_gain_in_this_panel'
+    elif any(d<0 for d in diffs):conclusion='mixed_or_partial_not_consistent'
+    else:conclusion='accuracy_hypothesis_not_supported_in_this_panel'
+    result.update(status='complete',accuracy_conclusion=conclusion,pooled_error_difference=sum(diffs)/2,
+                  non_adoption_redline=any(any(c['redlines'].values()) for c in result['per_seed']),
+                  recommend_adoption=False,
+                  interpretation='no automatic adoption: inspect tails/triangles/other structure even if accuracy improves and redlines do not fire')
+    result['between_seed_signed_bias_gap']={r:abs(result['per_seed'][0][r]['signed_edge_bias']-result['per_seed'][1][r]['signed_edge_bias']) for r in ('raw','ema')}
+    return result
diff --git a/experiments/pubmed_o_ema_runtime_v1/build_cost.py b/experiments/pubmed_o_ema_runtime_v1/build_cost.py
new file mode 100644
index 0000000..59ab119
--- /dev/null
+++ b/experiments/pubmed_o_ema_runtime_v1/build_cost.py
@@ -0,0 +1,34 @@
+"""Measured incremental EMA cost + sealed O costs; never activates a budget."""
+import argparse,pathlib,json
+from runtime_contract import ROOT,read,save,sha,jobs,source_binding,BUDGET,RESERVE
+def estimate(preflight):
+    history=read(ROOT/'initial_assets.json')['records'];p=preflight
+    # Use second same-input update, not cold update1. Retain both raw timings.
+    row=p['paired_updates'][1];ema_overhead=row['ema_wrapper_seconds']
+    component=max(row['unchanged_normal2_component_seconds'],row['original_normal2_seconds'])
+    # Engineering GPU was exclusive; old8-task measurements include real contention.
+    per_update=max(component,max(x['training_seconds']/1000 for x in history))+ema_overhead
+    chain=max(max(x['historical_two_chains_seconds']) for x in history)
+    extra_validation=3*p['validation']['ema']['seconds']
+    save_load=3*(p['checkpoint_save_seconds']+p['restore_seconds'])
+    historic_other=max(x['historical_total_elapsed_seconds']-x['training_seconds']-sum(x['historical_two_chains_seconds']) for x in history)
+    critical=1000*per_update+4*chain+historic_other+extra_validation+save_load
+    # Explicit small concurrency/state-cost planning allowance, not a measurement.
+    allowance=.10*critical;planned=critical+allowance+RESERVE
+    return dict(status='passed' if p['status']=='passed' and planned<=BUDGET else 'not_admitted',
+                schedule=jobs(),per_update_seconds=per_update,measured_incremental_ema_seconds=ema_overhead,
+                measured_warm_normal2_seconds=component,historical_max_chain_seconds=chain,
+                extra_three_ema_validations_seconds=extra_validation,checkpoint_extra_conservative_seconds=save_load,
+                historical_initialization_validation_save_seconds=historic_other,critical_compute_seconds=critical,
+                unmeasured_planning_allowance_seconds=allowance,delivery_seconds=RESERVE,planned_seconds=planned,
+                proposed_budget_seconds=BUDGET,source_sha256=source_binding()[1],
+                limits='five engineering updates; no new chain measured. State-dependent cost and two-task contention remain estimates; no completion guarantee.')
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--preflight',required=True);p.add_argument('--output',required=True);a=p.parse_args()
+    out=pathlib.Path(a.output)
+    if out.exists():raise FileExistsError(out)
+    report=read(a.preflight)
+    if report['source_sha256']!=source_binding()[1]:raise ValueError('preflight/source binding differs')
+    c=estimate(report);c.update(preflight_path=str(pathlib.Path(a.preflight).resolve()),preflight_sha256=sha(a.preflight))
+    save(out,c);print(json.dumps(c,indent=2))
+if __name__=='__main__':main()
diff --git a/experiments/pubmed_o_ema_runtime_v1/ema.py b/experiments/pubmed_o_ema_runtime_v1/ema.py
new file mode 100644
index 0000000..9a8440f
--- /dev/null
+++ b/experiments/pubmed_o_ema_runtime_v1/ema.py
@@ -0,0 +1,84 @@
+"""Fixed EMA readout. No optimizer, data, model factory or RNG calls.
+
+theta_bar[0] = theta[0]; theta_bar[k] = .99*theta_bar[k-1]+.01*theta[k].
+Call exactly once AFTER each completed normal2 optimizer update.
+"""
+import copy
+import torch
+
+DECAY = 0.99
+FORMAT = 'pubmed_o_ema_from_theta0_v1'
+
+def cpu_copy(value):
+    if torch.is_tensor(value):return value.detach().cpu().clone()
+    if isinstance(value,dict):return {k:cpu_copy(v) for k,v in value.items()}
+    if isinstance(value,list):return [cpu_copy(v) for v in value]
+    if isinstance(value,tuple):return tuple(cpu_copy(v) for v in value)
+    return copy.deepcopy(value)
+
+def parameters(model):
+    # Include serialization aliases, so tied parameters cannot be overwritten
+    # by a raw alias when an exported EMA state_dict is loaded.
+    return dict(model.named_parameters(remove_duplicate=False))
+
+class ParameterEMA:
+    def __init__(self, model):
+        ps=parameters(model)
+        if not ps:raise ValueError('empty parameter set')
+        if any(not p.is_floating_point() or not torch.isfinite(p).all() for p in ps.values()):
+            raise ValueError('EMA requires finite floating parameters')
+        self.shadow={n:p.detach().clone() for n,p in ps.items()}
+        self.updates=0
+        self.at_update_boundary=True
+
+    def _parameters(self,model):
+        ps=parameters(model)
+        if ps.keys()!=self.shadow.keys():raise ValueError('parameter names differ')
+        for n,p in ps.items():
+            q=self.shadow[n]
+            if p.shape!=q.shape or p.dtype!=q.dtype or p.device!=q.device:
+                raise ValueError('parameter shape/dtype/device differ: '+n)
+        return ps
+
+    @torch.no_grad()
+    def update(self,model,completed_updates):
+        if type(completed_updates) is not int or completed_updates!=self.updates+1:
+            raise ValueError('EMA needs the next complete normal2 update, once')
+        ps=self._parameters(model)
+        if any(not torch.isfinite(p).all() for p in ps.values()):
+            raise FloatingPointError('nonfinite raw parameters; EMA not updated')
+        for n,p in ps.items():
+            # Explicit two-operation FP32 implementation; no first-call copy,
+            # warmup, bias correction, scheduler or conditional update.
+            self.shadow[n].mul_(DECAY).add_(p.detach(),alpha=1.0-DECAY)
+        if any(not torch.isfinite(p).all() for p in self.shadow.values()):
+            raise FloatingPointError('nonfinite EMA; stop, do not use readout')
+        self.updates=completed_updates
+
+    def state_dict(self):
+        if not self.at_update_boundary:raise RuntimeError('incomplete raw/EMA update cannot be a resumable checkpoint')
+        return dict(format=FORMAT,decay=DECAY,updates=self.updates,shadow=cpu_copy(self.shadow))
+
+    def load_state_dict(self,state,model,expected_updates):
+        if state.get('format')!=FORMAT or state.get('decay')!=DECAY:
+            raise ValueError('EMA scientific contract mismatch')
+        if type(state.get('updates')) is not int or state['updates']!=expected_updates or expected_updates<0:
+            raise ValueError('EMA update counter mismatch')
+        ps=self._parameters(model);ss=state.get('shadow',{})
+        if ss.keys()!=ps.keys():raise ValueError('EMA saved parameter names differ')
+        for n,p in ps.items():
+            q=ss[n]
+            if not torch.is_tensor(q) or q.shape!=p.shape or q.dtype!=p.dtype or not torch.isfinite(q).all():
+                raise ValueError('invalid saved EMA parameter: '+n)
+        self.shadow={n:ss[n].detach().to(device=p.device).clone() for n,p in ps.items()}
+        self.updates=expected_updates
+        self.at_update_boundary=True
+
+    def readout_state_dict(self,model):
+        if not self.at_update_boundary:raise RuntimeError('incomplete raw/EMA update cannot be evaluated')
+        self._parameters(model)
+        # Buffers (including float priors and integer counters) are COPIED.
+        # This does not modify the live training model, optimizer, mode or RNG.
+        state=cpu_copy(model.state_dict())
+        for n,p in self.shadow.items():state[n]=cpu_copy(p)
+        return state
