+            if edges.shape!=(2,m['edges']) or fam.shape!=(m['edges'],) or np.any(edges<0) or np.any(edges>=len(types)) or np.any(edges[0]>=edges[1]) or len(set(map(tuple,edges.T)))!=m['edges']:raise ValueError('graph contract')
