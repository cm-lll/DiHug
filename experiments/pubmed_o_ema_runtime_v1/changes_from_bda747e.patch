+    return result
+
+def weighted_rows(features,nodes):
+    if len(features)!=7:raise ValueError('one clean and six noisy states required')
+    return np.concatenate([f[nodes]*(np.sqrt(2.) if i==0 else 1.) for i,f in enumerate(features)],axis=0)
+
