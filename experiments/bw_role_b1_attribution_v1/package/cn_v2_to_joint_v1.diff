+    assert np.array_equal(state, np.isin(np.arange(len(state)),case['clean_ids']).astype(np.uint8))
+    assert row['exact_coverage']
+    state2=np.zeros_like(state);rng2=np.random.default_rng(719);rng_state=c.rng_save(rng2,'cpu')
