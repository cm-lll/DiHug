+def scalar_fd(f,p,free):
+    result=np.zeros_like(p);h=1e-5
+    for j in np.flatnonzero(free):
+        a=p.copy();b=p.copy();z=np.log(p[j])-np.log1p(-p[j])
+        a[j]=1/(1+np.exp(-(z+h)));b[j]=1/(1+np.exp(-(z-h)))
+        result[j]=(f(a)-f(b))/(2*h)
+    return result
+
